# Keep project dependency files (override *.txt above)
!requirements.txt
!training_scripts/requirements_training.txt
# Keep CI workflows (override *.yml above) and the enhancement review docs
# (override *.md above).
!.github/
!.github/**
!ml-app-enhancement-reviews/
!ml-app-enhancement-reviews/*.md
# Benchmark baselines are small, deterministic reference numbers that CI checks
# against; unlike checkpoints they belong in the repo.
!training/benchmarks/
!training/benchmarks/*.json
!training/README.md
