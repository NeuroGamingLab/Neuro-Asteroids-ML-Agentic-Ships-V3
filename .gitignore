# ============================================
# ML artefacts
# ============================================

# Python bytecode
__pycache__/
*.py[cod]

# Model weights and exports. Trained policies are build outputs, not source;
# committing them bloats history and makes diffs unreadable.
*.h5
*.keras
*.pb
*.ckpt
*.tflite
models/**/*.bin
models/**/model.json
models/*.json

# Training data exports and preprocessed arrays
*.npy
*.npz
marl_training_data_*.json
training_data/
processed_data/

# Training run logs and checkpoints
training_runs/

# IDE Files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

*.md 
*.txt
*.docx
*.doc
